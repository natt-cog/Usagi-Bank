<%@ page pageEncoding="UTF-8" %>
<script>
/* 表示テーマ (ライト/ダーク) を描画前に適用し、ちらつきを防ぐ */
(function () {
    var KEY = 'usagi.theme', body = document.body, theme = null;
    try { theme = window.localStorage.getItem(KEY); } catch (e) {}
    if (theme !== 'dark' && theme !== 'light') {
        theme = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
    }
    if (theme === 'dark') { body.className = body.className ? body.className + ' dark' : 'dark'; }
    window.usagiToggleTheme = function () {
        var dark = !/(^|\s)dark(\s|$)/.test(body.className);
        body.className = dark ? (body.className ? body.className + ' dark' : 'dark')
                              : body.className.replace(/(^|\s)dark(\s|$)/, ' ').replace(/^\s+|\s+$/g, '');
        try { window.localStorage.setItem(KEY, dark ? 'dark' : 'light'); } catch (e) {}
        window.usagiSyncThemeToggle();
    };
    window.usagiSyncThemeToggle = function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) { return; }
        var dark = /(^|\s)dark(\s|$)/.test(body.className);
        btn.innerHTML = dark ? '&#9728; ライト' : '&#9790; ダーク';
        btn.title = dark ? 'ライトモードに切り替え' : 'ダークモードに切り替え';
        btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
    };
})();
</script>
