<%@ page pageEncoding="UTF-8" %>
<script>
(function () {
    var KEY = 'usagi.theme', body = document.body, saved = null;
    try { saved = window.localStorage.getItem(KEY); } catch (e) {}
    var dark = saved ? saved === 'dark' : !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
    function apply(on) {
        body.className = (' ' + body.className + ' ').replace(/ dark /g, ' ').replace(/^\s+|\s+$/g, '') + (on ? ' dark' : '');
        var btn = document.getElementById('theme-toggle');
        if (btn) { btn.innerHTML = on ? 'ライトモード' : 'ダークモード'; btn.title = on ? 'ライトモードに切替' : 'ダークモードに切替'; }
    }
    apply(dark);
    window.usagiToggleTheme = function () {
        dark = !dark;
        apply(dark);
        try { window.localStorage.setItem(KEY, dark ? 'dark' : 'light'); } catch (e) {}
        return false;
    };
    window.usagiApplyTheme = function () { apply(dark); };
})();
</script>
