<%@ page pageEncoding="UTF-8" %>
<script>
(function () {
    var KEY = 'usagi.theme', body = document.body, saved = null;
    try { saved = window.localStorage.getItem(KEY); } catch (e) {}
    var dark = saved ? saved === 'dark' : !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
    function apply() {
        var cls = (' ' + body.className + ' ').replace(/ dark /g, ' ') + (dark ? 'dark' : '');
        body.className = cls.replace(/^\s+|\s+$/g, '');
        var btn = document.getElementById('theme-toggle');
        if (btn) {
            btn.innerHTML = dark ? 'ライトモード' : 'ダークモード';
            btn.title = dark ? 'ライトモードに切替' : 'ダークモードに切替';
        }
    }
    apply();
    window.usagiApplyTheme = apply;
    window.usagiToggleTheme = function () {
        dark = !dark;
        apply();
        try { window.localStorage.setItem(KEY, dark ? 'dark' : 'light'); } catch (e) {}
        return false;
    };
})();
</script>
